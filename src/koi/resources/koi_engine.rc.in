#include <winver.h>
#pragma code_page(65001)

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
FILEFLAGS 0x1L
#else
FILEFLAGS 0x0L
#endif
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Koi Chess Engine Contributors"
            VALUE "FileDescription", "@KOI_PE_FILE_DESCRIPTION@"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "@KOI_PE_INTERNAL_NAME@"
            VALUE "LegalCopyright", "Copyright (C) 2026 Nguyễn Nhật Quang (GPL-3.0-or-later)"
            VALUE "OriginalFilename", "@KOI_PE_ORIGINAL_FILENAME@"
            VALUE "ProductName", "Koi Chess Engine"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
            VALUE "Comments", "Open-source UCI chess engine (commit @KOI_ENGINE_GIT_COMMIT@, https://github.com/nhatquang1701/Koi)"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
