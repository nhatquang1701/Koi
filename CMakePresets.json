{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 31,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-release",
      "displayName": "Windows x64 Release (MSVC + Ninja)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-release",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "cl"
      }
    },
    {
      "name": "windows-debug",
      "displayName": "Windows x64 Debug (MSVC + Ninja)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-debug",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "cl"
      }
    },
    {
      "name": "windows-asan",
      "displayName": "Windows x64 ASan Debug (MSVC + Ninja)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-asan",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "cl",
        "KOI_SANITIZE": "ON"
      }
    },
    {
      "name": "linux-gcc-release",
      "displayName": "Linux x86-64 Release (GCC 14 + Ninja)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-gcc-release",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "gcc-14",
        "CMAKE_CXX_COMPILER": "g++-14"
      }
    },
    {
      "name": "linux-clang-release",
      "displayName": "Linux x86-64 Release (Clang 18 + Ninja)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-clang-release",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "clang-18",
        "CMAKE_CXX_COMPILER": "clang++-18"
      }
    },
    {
      "name": "linux-gcc-tsan",
      "displayName": "Linux x86-64 TSan Debug (GCC 14 + Ninja)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-gcc-tsan",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "gcc-14",
        "CMAKE_CXX_COMPILER": "g++-14",
        "KOI_TSAN": "ON"
      }
    },
    {
      "name": "macos-arm64-release",
      "displayName": "macOS arm64 Release (Clang + Ninja)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/macos-arm64-release",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "KOI_BUILD_MODULES": "OFF",
        "KOI_STATIC_RUNTIME": "OFF"
      }
    },
    {
      "name": "macos-arm64-debug",
      "displayName": "macOS arm64 Debug (Clang + Ninja)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/macos-arm64-debug",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "KOI_BUILD_MODULES": "OFF",
        "KOI_STATIC_RUNTIME": "OFF"
      }
    }
  ],
  "buildPresets": [
    { "name": "windows-release", "configurePreset": "windows-release", "configuration": "Release" },
    { "name": "windows-debug", "configurePreset": "windows-debug", "configuration": "Debug" },
    { "name": "windows-asan", "configurePreset": "windows-asan", "configuration": "Debug" },
    { "name": "linux-gcc-release", "configurePreset": "linux-gcc-release", "configuration": "Release" },
    { "name": "linux-clang-release", "configurePreset": "linux-clang-release", "configuration": "Release" },
    { "name": "linux-gcc-tsan", "configurePreset": "linux-gcc-tsan", "configuration": "Debug" },
    { "name": "macos-arm64-release", "configurePreset": "macos-arm64-release", "configuration": "Release" },
    { "name": "macos-arm64-debug", "configurePreset": "macos-arm64-debug", "configuration": "Debug" }
  ],
  "testPresets": [
    {
      "name": "windows-release",
      "configurePreset": "windows-release",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "windows-debug",
      "configurePreset": "windows-debug",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "linux-gcc-release",
      "configurePreset": "linux-gcc-release",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "linux-clang-release",
      "configurePreset": "linux-clang-release",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "macos-arm64-release",
      "configurePreset": "macos-arm64-release",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "macos-arm64-debug",
      "configurePreset": "macos-arm64-debug",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    }
  ]
}
